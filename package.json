{
  "name": "youtube-reborn",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "Browser extension that replaces the YouTube home feed with a local, subscription-seeded discovery feed.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/screenshots/shoot.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
